# AI 解卦引擎配置（OpenAI 兼容 API）
# 如不配置，将使用模拟解卦

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 服务监听：默认只允许本机访问。改为 0.0.0.0 前请自行加反向代理与鉴权
APP_HOST=127.0.0.1
APP_PORT=8000

# 安全限制
MAX_BODY_BYTES=1048576          # 单次请求体上限（字节），超限返回 413
RATE_LIMIT_PER_MINUTE=10        # 单 IP 每分钟解卦次数，0 表示关闭限流
ADMIN_TOKEN=                    # 查看 /api/health 详情所需令牌，留空则永不返回详情
TRUST_PROXY=0                   # 置于内网穿透/反向代理后置 1，限流按真实访客 IP 统计
