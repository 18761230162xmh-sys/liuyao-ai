{
  "111111": {
    "index": 1,
    "name": "乾为天",
    "upper": "乾",
    "lower": "乾",
    "upper_symbol": "☰",
    "lower_symbol": "☰",
    "palace": "乾",
    "element": "金",
    "statement": "元亨利贞。",
    "shi_position": 6,
    "yao_ci": [
      "潜龙勿用。",
      "见龙在田，利见大人。",
      "君子终日乾乾，夕惕若，厉无咎。",
      "或跃在渊，无咎。",
      "飞龙在天，利见大人。",
      "亢龙有悔，用九则群龙无首，吉。"
    ]
  },
  "011111": {
    "index": 44,
    "name": "天风姤",
    "upper": "乾",
    "lower": "巽",
    "upper_symbol": "☰",
    "lower_symbol": "☴",
    "palace": "乾",
    "element": "金",
    "statement": "女壮，勿用取女。",
    "shi_position": 1,
    "yao_ci": [
      "系于金柅，贞吉。有攸往见凶，羸豕孚蹢躅。",
      "包有鱼，无咎，不利宾。",
      "臀无肤，其行次且，厉无大咎。",
      "包无鱼，起凶。",
      "以杞包瓜，含章，有陨自天。",
      "姤其角，吝无咎。"
    ]
  },
  "001111": {
    "index": 33,
    "name": "天山遁",
    "upper": "乾",
    "lower": "艮",
    "upper_symbol": "☰",
    "lower_symbol": "☶",
    "palace": "乾",
    "element": "金",
    "statement": "亨，小利贞。",
    "shi_position": 2,
    "yao_ci": [
      "遁尾，厉，勿用有攸往。",
      "执之用黄牛之革，莫之胜说。",
      "系遁，有疾厉，畜臣妾吉。",
      "好遁，君子吉，小人否。",
      "嘉遁，贞吉。",
      "肥遁，无不利。"
    ]
  },
  "000111": {
    "index": 12,
    "name": "天地否",
    "upper": "乾",
    "lower": "坤",
    "upper_symbol": "☰",
    "lower_symbol": "☷",
    "palace": "乾",
    "element": "金",
    "statement": "否之匪人，不利君子贞。大往小来。",
    "shi_position": 3,
    "yao_ci": [
      "拔茅茹，以其汇，贞吉亨。",
      "包承，小人吉，大人否亨。",
      "包羞。",
      "有命无咎，畴离祉。",
      "休否，大人吉。其亡其亡，系于苞桑。",
      "倾否，先否后喜。"
    ]
  },
  "000011": {
    "index": 20,
    "name": "风地观",
    "upper": "巽",
    "lower": "坤",
    "upper_symbol": "☴",
    "lower_symbol": "☷",
    "palace": "乾",
    "element": "金",
    "statement": "盥而不荐，有孚颙若。",
    "shi_position": 4,
    "yao_ci": [
      "童观，小人无咎，君子吝。",
      "窥观，利女贞。",
      "观我生，进退。",
      "观国之光，利用宾于王。",
      "观我生，君子无咎。",
      "观其生，君子无咎。"
    ]
  },
  "000001": {
    "index": 23,
    "name": "山地剥",
    "upper": "艮",
    "lower": "坤",
    "upper_symbol": "☶",
    "lower_symbol": "☷",
    "palace": "乾",
    "element": "金",
    "statement": "不利有攸往。",
    "shi_position": 5,
    "yao_ci": [
      "剥床以足，蔑贞凶。",
      "剥床以辨，蔑贞凶。",
      "剥之，无咎。",
      "剥床以肤，凶。",
      "贯鱼以宫人宠，无不利。",
      "硕果不食，君子得舆，小人剥庐。"
    ]
  },
  "000101": {
    "index": 35,
    "name": "火地晋",
    "upper": "离",
    "lower": "坤",
    "upper_symbol": "☲",
    "lower_symbol": "☷",
    "palace": "乾",
    "element": "金",
    "statement": "康侯用锡马蕃庶，昼日三接。",
    "shi_position": 4,
    "yao_ci": [
      "晋如摧如，贞吉。罔孚，裕无咎。",
      "晋如愁如，贞吉。受兹介福，于其王母。",
      "众允，悔亡。",
      "晋如鼫鼠，贞厉。",
      "悔亡，失得勿恤，往吉无不利。",
      "晋其角，维用伐邑，厉吉无咎，贞吝。"
    ]
  },
  "111101": {
    "index": 14,
    "name": "火天大有",
    "upper": "离",
    "lower": "乾",
    "upper_symbol": "☲",
    "lower_symbol": "☰",
    "palace": "乾",
    "element": "金",
    "statement": "元亨。",
    "shi_position": 3,
    "yao_ci": [
      "无交害，匪咎，艰则无咎。",
      "大车以载，有攸往，无咎。",
      "公用亨于天子，小人弗克。",
      "匪其彭，无咎。",
      "厥孚交如，威如，吉。",
      "自天佑之，吉无不利。"
    ]
  },
  "010010": {
    "index": 29,
    "name": "坎为水",
    "upper": "坎",
    "lower": "坎",
    "upper_symbol": "☵",
    "lower_symbol": "☵",
    "palace": "坎",
    "element": "水",
    "statement": "习坎，有孚，维心亨。行有尚。",
    "shi_position": 6,
    "yao_ci": [
      "习坎，入于坎窞，凶。",
      "坎有险，求小得。",
      "来之坎坎，险且枕，入于坎窞，勿用。",
      "樽酒簋贰，用缶，纳约自牖，终无咎。",
      "坎不盈，祗既平，无咎。",
      "系用徽纆，寘于丛棘，三岁不得，凶。"
    ]
  },
  "110010": {
    "index": 60,
    "name": "水泽节",
    "upper": "坎",
    "lower": "兑",
    "upper_symbol": "☵",
    "lower_symbol": "☱",
    "palace": "坎",
    "element": "水",
    "statement": "亨。苦节不可贞。",
    "shi_position": 1,
    "yao_ci": [
      "不出户庭，无咎。",
      "不出门庭，凶。",
      "不节若，则嗟若，无咎。",
      "安节，亨。",
      "甘节，吉，往有尚。",
      "苦节，贞凶，悔亡。"
    ]
  },
  "100010": {
    "index": 3,
    "name": "水雷屯",
    "upper": "坎",
    "lower": "震",
    "upper_symbol": "☵",
    "lower_symbol": "☳",
    "palace": "坎",
    "element": "水",
    "statement": "元亨利贞。勿用有攸往，利建侯。",
    "shi_position": 2,
    "yao_ci": [
      "磐桓，利居贞，利建侯。",
      "屯如邅如，乘马班如，匪寇婚媾，女子贞不字，十年乃字。",
      "即鹿无虞，惟入于林中，君子几不如舍，往吝。",
      "乘马班如，求婚媾，往吉无不利。",
      "屯其膏，小贞吉，大贞凶。",
      "乘马班如，泣血涟如。"
    ]
  },
  "101010": {
    "index": 63,
    "name": "水火既济",
    "upper": "坎",
    "lower": "离",
    "upper_symbol": "☵",
    "lower_symbol": "☲",
    "palace": "坎",
    "element": "水",
    "statement": "亨小，利贞。初吉终乱。",
    "shi_position": 3,
    "yao_ci": [
      "曳其轮，濡其尾，无咎。",
      "妇丧其茀，勿逐，七日得。",
      "高宗伐鬼方，三年克之，小人勿用。",
      "繻有衣袽，终日戒。",
      "东邻杀牛，不如西邻之禴祭，实受其福。",
      "濡其首，厉。"
    ]
  },
  "101110": {
    "index": 49,
    "name": "泽火革",
    "upper": "兑",
    "lower": "离",
    "upper_symbol": "☱",
    "lower_symbol": "☲",
    "palace": "坎",
    "element": "水",
    "statement": "己日乃孚。元亨利贞，悔亡。",
    "shi_position": 4,
    "yao_ci": [
      "巩用黄牛之革。",
      "巳日乃革之，征吉无咎。",
      "征凶，贞厉。革言三就，有孚。",
      "悔亡，有孚改命，吉。",
      "大人虎变，未占有孚。",
      "君子豹变，小人革面，征凶，居贞吉。"
    ]
  },
  "101100": {
    "index": 55,
    "name": "雷火丰",
    "upper": "震",
    "lower": "离",
    "upper_symbol": "☳",
    "lower_symbol": "☲",
    "palace": "坎",
    "element": "水",
    "statement": "亨，王假之，勿忧，宜日中。",
    "shi_position": 5,
    "yao_ci": [
      "遇其配主，虽旬无咎，往有尚。",
      "丰其蔀，日中见斗，往得疑疾，有孚发若，吉。",
      "丰其沛，日中见沫，折其右肱，无咎。",
      "丰其蔀，日中见斗，遇其夷主，吉。",
      "来章，有庆誉，吉。",
      "丰其屋，蔀其家，窥其户阒其无人，三岁不觌，凶。"
    ]
  },
  "101000": {
    "index": 36,
    "name": "地火明夷",
    "upper": "坤",
    "lower": "离",
    "upper_symbol": "☷",
    "lower_symbol": "☲",
    "palace": "坎",
    "element": "水",
    "statement": "利艰贞。",
    "shi_position": 4,
    "yao_ci": [
      "明夷于飞，垂其翼。君子于行，三日不食。有攸往，主人有言。",
      "明夷，夷于左股，用拯马壮，吉。",
      "明夷于南狩，得其大首，不可疾贞。",
      "入于左腹，获明夷之心，于出门庭。",
      "箕子之明夷，利贞。",
      "不明晦，初登于天，后入于地。"
    ]
  },
  "000010": {
    "index": 8,
    "name": "水地比",
    "upper": "坎",
    "lower": "坤",
    "upper_symbol": "☵",
    "lower_symbol": "☷",
    "palace": "坎",
    "element": "水",
    "statement": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
    "shi_position": 3,
    "yao_ci": [
      "有孚比之，无咎。有孚盈缶，终来有它吉。",
      "比之自内，贞吉。",
      "比之匪人。",
      "外比之，贞吉。",
      "显比，王用三驱，失前禽，邑人不诫，吉。",
      "比之无首，凶。"
    ]
  },
  "001001": {
    "index": 52,
    "name": "艮为山",
    "upper": "艮",
    "lower": "艮",
    "upper_symbol": "☶",
    "lower_symbol": "☶",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 6,
    "yao_ci": [
      "艮其趾，无咎，利永贞。",
      "艮其腓，不拯其随，其心不快。",
      "艮其限，列其夤，厉薰心。",
      "艮其身，无咎。",
      "艮其辅，言有序，悔亡。",
      "敦艮，吉。"
    ]
  },
  "101001": {
    "index": 22,
    "name": "山火贲",
    "upper": "艮",
    "lower": "离",
    "upper_symbol": "☶",
    "lower_symbol": "☲",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "贲其趾，舍车而徒。",
      "贲其须。",
      "贲如濡如，永贞吉。",
      "贲如皤如，白马翰如，匪寇婚媾。",
      "贲于丘园，束帛戋戋，吝终吉。",
      "白贲，无咎。"
    ]
  },
  "111001": {
    "index": 26,
    "name": "山天大畜",
    "upper": "艮",
    "lower": "乾",
    "upper_symbol": "☶",
    "lower_symbol": "☰",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "有厉，利已。",
      "舆说輹。",
      "良马逐，利艰贞。曰闲舆卫，利有攸往。",
      "童牛之牿，元吉。",
      "豮豕之牙，吉。",
      "何天之衢，亨。"
    ]
  },
  "110001": {
    "index": 41,
    "name": "山泽损",
    "upper": "艮",
    "lower": "兑",
    "upper_symbol": "☶",
    "lower_symbol": "☱",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "已事遄往，无咎，酌损之。",
      "利贞，征凶，弗损益之。",
      "三人行则损一人，一人行则得其友。",
      "损其疾，使遄有喜，无咎。",
      "或益之十朋之龟，弗克违，元吉。",
      "弗损益之，无咎，贞吉，利有攸往，得臣无家。"
    ]
  },
  "110101": {
    "index": 38,
    "name": "火泽睽",
    "upper": "离",
    "lower": "兑",
    "upper_symbol": "☲",
    "lower_symbol": "☱",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "悔亡。丧马勿逐自复，见恶人无咎。",
      "遇主于巷，无咎。",
      "见舆曳，其牛掣，其人天且劓，无初有终。",
      "睽孤，遇元夫，交孚，厉无咎。",
      "悔亡，厥宗噬肤，往何咎。",
      "睽孤，见豕负涂，载鬼一车，先张之弧后说之弧，匪寇婚媾，往遇雨则吉。"
    ]
  },
  "110111": {
    "index": 10,
    "name": "天泽履",
    "upper": "乾",
    "lower": "兑",
    "upper_symbol": "☰",
    "lower_symbol": "☱",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 5,
    "yao_ci": [
      "素履往，无咎。",
      "履道坦坦，幽人贞吉。",
      "眇能视，跛能履，履虎尾咥人，凶。武人为于大君。",
      "履虎尾，愬愬终吉。",
      "夬履，贞厉。",
      "视履考祥，其旋元吉。"
    ]
  },
  "110011": {
    "index": 61,
    "name": "风泽中孚",
    "upper": "巽",
    "lower": "兑",
    "upper_symbol": "☴",
    "lower_symbol": "☱",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "虞吉，有它不燕。",
      "鸣鹤在阴，其子和之。我有好爵，吾与尔靡之。",
      "得敌，或鼓或罢，或泣或歌。",
      "月几望，马匹亡，无咎。",
      "有孚挛如，无咎。",
      "翰音登于天，贞凶。"
    ]
  },
  "001011": {
    "index": 53,
    "name": "风山渐",
    "upper": "巽",
    "lower": "艮",
    "upper_symbol": "☴",
    "lower_symbol": "☶",
    "palace": "艮",
    "element": "土",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "鸿渐于干，小子厉，有言无咎。",
      "鸿渐于磐，饮食衎衎，吉。",
      "鸿渐于陆，夫征不复，妇孕不育，凶。利御寇。",
      "鸿渐于木，或得其桷，无咎。",
      "鸿渐于陵，妇三岁不孕，终莫之胜，吉。",
      "鸿渐于逵，其羽可用为仪，吉。"
    ]
  },
  "100100": {
    "index": 51,
    "name": "震为雷",
    "upper": "震",
    "lower": "震",
    "upper_symbol": "☳",
    "lower_symbol": "☳",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 6,
    "yao_ci": [
      "震来虩虩，后笑言哑哑，吉。",
      "震来厉，亿丧贝，跻于九陵，勿逐，七日得。",
      "震苏苏，震行无眚。",
      "震遂泥。",
      "震往来厉，亿无丧，有事。",
      "震索索，视矍矍，征凶。震不于其躬于其邻，无咎，婚媾有言。"
    ]
  },
  "000100": {
    "index": 16,
    "name": "雷地豫",
    "upper": "震",
    "lower": "坤",
    "upper_symbol": "☳",
    "lower_symbol": "☷",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "鸣豫，凶。",
      "介于石，不终日，贞吉。",
      "盱豫悔，迟有悔。",
      "由豫，大有得，勿疑，朋盍簪。",
      "贞疾，恒不死。",
      "冥豫成，有渝无咎。"
    ]
  },
  "010100": {
    "index": 40,
    "name": "雷水解",
    "upper": "震",
    "lower": "坎",
    "upper_symbol": "☳",
    "lower_symbol": "☵",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "无咎。",
      "田获三狐，得黄矢，贞吉。",
      "负且乘，致寇至，贞吝。",
      "解而拇，朋至斯孚。",
      "君子维有解，吉，有孚于小人。",
      "公用射隼于高墉之上，获之，无不利。"
    ]
  },
  "011100": {
    "index": 32,
    "name": "雷风恒",
    "upper": "震",
    "lower": "巽",
    "upper_symbol": "☳",
    "lower_symbol": "☴",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "浚恒，贞凶，无攸利。",
      "悔亡。",
      "不恒其德，或承之羞，贞吝。",
      "田无禽。",
      "恒其德，贞，妇人吉，夫子凶。",
      "振恒，凶。"
    ]
  },
  "011000": {
    "index": 46,
    "name": "地风升",
    "upper": "坤",
    "lower": "巽",
    "upper_symbol": "☷",
    "lower_symbol": "☴",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "允升，大吉。",
      "孚乃利用禴，无咎。",
      "升虚邑。",
      "王用亨于岐山，吉无咎。",
      "贞吉，升阶。",
      "冥升，利于不息之贞。"
    ]
  },
  "011010": {
    "index": 48,
    "name": "水风井",
    "upper": "坎",
    "lower": "巽",
    "upper_symbol": "☵",
    "lower_symbol": "☴",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 5,
    "yao_ci": [
      "井泥不食，旧井无禽。",
      "井谷射鲋，瓮敝漏。",
      "井渫不食，为我心恻，可用汲。王明并受其福。",
      "井甃，无咎。",
      "井洌寒泉，食。",
      "井收勿幕，有孚元吉。"
    ]
  },
  "011110": {
    "index": 28,
    "name": "泽风大过",
    "upper": "兑",
    "lower": "巽",
    "upper_symbol": "☱",
    "lower_symbol": "☴",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "藉用白茅，无咎。",
      "枯杨生稊，老夫得其女妻，无不利。",
      "栋桡，凶。",
      "栋隆，吉，有它吝。",
      "枯杨生华，老妇得其士夫，无咎无誉。",
      "过涉灭顶，凶无咎。"
    ]
  },
  "100110": {
    "index": 17,
    "name": "泽雷随",
    "upper": "兑",
    "lower": "震",
    "upper_symbol": "☱",
    "lower_symbol": "☳",
    "palace": "震",
    "element": "木",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "官有渝，贞吉，出门交有功。",
      "系小子，失丈夫。",
      "系丈夫，失小子，随有求得，利居贞。",
      "随有获，贞凶。有孚在道，以明，何咎。",
      "孚于嘉，吉。",
      "拘系之，乃从维之，王用亨于西山。"
    ]
  },
  "011011": {
    "index": 57,
    "name": "巽为风",
    "upper": "巽",
    "lower": "巽",
    "upper_symbol": "☴",
    "lower_symbol": "☴",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 6,
    "yao_ci": [
      "进退，利武人之贞。",
      "巽在床下，用史巫纷若，吉无咎。",
      "频巽，吝。",
      "悔亡，田获三品。",
      "贞吉悔亡，无不利。无初有终，先庚三日后庚三日，吉。",
      "巽在床下，丧其资斧，贞凶。"
    ]
  },
  "111011": {
    "index": 9,
    "name": "风天小畜",
    "upper": "巽",
    "lower": "乾",
    "upper_symbol": "☴",
    "lower_symbol": "☰",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "复自道，何其咎，吉。",
      "牵复，吉。",
      "舆说辐，夫妻反目。",
      "有孚，血去惕出，无咎。",
      "有孚挛如，富以其邻。",
      "既雨既处，尚德载，妇贞厉。月几望，君子征凶。"
    ]
  },
  "101011": {
    "index": 37,
    "name": "风火家人",
    "upper": "巽",
    "lower": "离",
    "upper_symbol": "☴",
    "lower_symbol": "☲",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "闲有家，悔亡。",
      "无攸遂，在中馈，贞吉。",
      "家人嗃嗃，悔厉吉。妇子嘻嘻，终吝。",
      "富家，大吉。",
      "王假有家，勿恤，吉。",
      "有孚威如，终吉。"
    ]
  },
  "100011": {
    "index": 42,
    "name": "风雷益",
    "upper": "巽",
    "lower": "震",
    "upper_symbol": "☴",
    "lower_symbol": "☳",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "利用为大作，元吉，无咎。",
      "或益之十朋之龟，弗克违，永贞吉。王用享于帝，吉。",
      "益之用凶事，无咎。有孚中行，告公用圭。",
      "中行告公从，利用为依迁国。",
      "有孚惠心，勿问元吉，有孚惠我德。",
      "莫益之，或击之，立心勿恒，凶。"
    ]
  },
  "100111": {
    "index": 25,
    "name": "天雷无妄",
    "upper": "乾",
    "lower": "震",
    "upper_symbol": "☰",
    "lower_symbol": "☳",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "无妄往吉。",
      "不耕获，不菑畬，则利有攸往。",
      "无妄之灾，或系之牛，行人之得，邑人之灾。",
      "可贞，无咎。",
      "无妄之疾，勿药有喜。",
      "无妄行，有眚，无攸利。"
    ]
  },
  "100101": {
    "index": 21,
    "name": "火雷噬嗑",
    "upper": "离",
    "lower": "震",
    "upper_symbol": "☲",
    "lower_symbol": "☳",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 5,
    "yao_ci": [
      "屦校灭趾，无咎。",
      "噬肤灭鼻，无咎。",
      "噬腊肉，遇毒，小吝无咎。",
      "噬干胏，得金矢，利艰贞吉。",
      "噬干肉，得黄金，贞厉无咎。",
      "何校灭耳，凶。"
    ]
  },
  "100001": {
    "index": 27,
    "name": "山雷颐",
    "upper": "艮",
    "lower": "震",
    "upper_symbol": "☶",
    "lower_symbol": "☳",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "舍尔灵龟，观我朵颐，凶。",
      "颠颐，拂经，于丘颐，征凶。",
      "拂颐，贞凶，十年勿用，无攸利。",
      "颠颐，吉。虎视眈眈，其欲逐逐，无咎。",
      "拂经，居贞吉，不可涉大川。",
      "由颐，厉吉，利涉大川。"
    ]
  },
  "011001": {
    "index": 18,
    "name": "山风蛊",
    "upper": "艮",
    "lower": "巽",
    "upper_symbol": "☶",
    "lower_symbol": "☴",
    "palace": "巽",
    "element": "木",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "干父之蛊，有子，考无咎，厉终吉。",
      "干母之蛊，不可贞。",
      "干父之蛊，小有悔，无大咎。",
      "裕父之蛊，往见吝。",
      "干父之蛊，用誉。",
      "不事王侯，高尚其事。"
    ]
  },
  "101101": {
    "index": 30,
    "name": "离为火",
    "upper": "离",
    "lower": "离",
    "upper_symbol": "☲",
    "lower_symbol": "☲",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 6,
    "yao_ci": [
      "履错然，敬之，无咎。",
      "黄离，元吉。",
      "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
      "突如其来如，焚如死如弃如。",
      "出涕沱若，戚嗟若，吉。",
      "王用出征，有嘉折首，获匪其丑，无咎。"
    ]
  },
  "001101": {
    "index": 56,
    "name": "火山旅",
    "upper": "离",
    "lower": "艮",
    "upper_symbol": "☲",
    "lower_symbol": "☶",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "旅琐琐，斯其所取灾。",
      "旅即次，怀其资，得童仆贞。",
      "旅焚其次，丧其童仆，贞厉。",
      "旅于处，得其资斧，我心不快。",
      "射雉一矢亡，终以誉命。",
      "鸟焚其巢，旅人先笑后号咷，丧牛于易，凶。"
    ]
  },
  "011101": {
    "index": 50,
    "name": "火风鼎",
    "upper": "离",
    "lower": "巽",
    "upper_symbol": "☲",
    "lower_symbol": "☴",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "鼎颠趾，利出否。得妾以其子，无咎。",
      "鼎有实，我仇有疾，不我能即，吉。",
      "鼎耳革，其行塞，雉膏不食。方雨亏悔，终吉。",
      "鼎折足，覆公餗，其形渥，凶。",
      "鼎黄耳金铉，利贞。",
      "鼎玉铉，大吉无不利。"
    ]
  },
  "010101": {
    "index": 64,
    "name": "火水未济",
    "upper": "离",
    "lower": "坎",
    "upper_symbol": "☲",
    "lower_symbol": "☵",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "濡其尾，吝。",
      "曳其轮，贞吉。",
      "未济，征凶，利涉大川。",
      "贞吉悔亡。震用伐鬼方，三年有赏于大国。",
      "贞吉无悔，君子之光，有孚吉。",
      "有孚于饮酒，无咎。濡其首，有孚失是。"
    ]
  },
  "010001": {
    "index": 4,
    "name": "山水蒙",
    "upper": "艮",
    "lower": "坎",
    "upper_symbol": "☶",
    "lower_symbol": "☵",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "发蒙，利用刑人，用说桎梏，以往吝。",
      "包蒙吉，纳妇吉，子克家。",
      "勿用取女，见金夫不有躬，无攸利。",
      "困蒙，吝。",
      "童蒙，吉。",
      "击蒙，不利为寇，利御寇。"
    ]
  },
  "010011": {
    "index": 59,
    "name": "风水涣",
    "upper": "巽",
    "lower": "坎",
    "upper_symbol": "☴",
    "lower_symbol": "☵",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 5,
    "yao_ci": [
      "用拯马壮，吉。",
      "涣奔其机，悔亡。",
      "涣其躬，无悔。",
      "涣其群，元吉。涣有丘，匪夷所思。",
      "涣汗其大号，涣王居，无咎。",
      "涣其血去逖出，无咎。"
    ]
  },
  "010111": {
    "index": 6,
    "name": "天水讼",
    "upper": "乾",
    "lower": "坎",
    "upper_symbol": "☰",
    "lower_symbol": "☵",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "不永所事，小有言，终吉。",
      "不克讼，归而逋其邑人三百户，无眚。",
      "食旧德，贞厉终吉，或从王事，无成。",
      "不克讼，复即命渝，安贞吉。",
      "讼，元吉。",
      "或锡之鞶带，终朝三褫之。"
    ]
  },
  "101111": {
    "index": 13,
    "name": "天火同人",
    "upper": "乾",
    "lower": "离",
    "upper_symbol": "☰",
    "lower_symbol": "☲",
    "palace": "离",
    "element": "火",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "同人于门，无咎。",
      "同人于宗，吝。",
      "伏戎于莽，升其高陵，三岁不兴。",
      "乘其墉，弗克攻，吉。",
      "同人先号咷而后笑，大师克相遇。",
      "同人于郊，无悔。"
    ]
  },
  "000000": {
    "index": 2,
    "name": "坤为地",
    "upper": "坤",
    "lower": "坤",
    "upper_symbol": "☷",
    "lower_symbol": "☷",
    "palace": "坤",
    "element": "土",
    "statement": "元亨，利牝马之贞。君子有攸往，先迷后得主，利。西南得朋，东北丧朋。安贞吉。",
    "shi_position": 6,
    "yao_ci": [
      "履霜，坚冰至。",
      "直方大，不习无不利。",
      "含章可贞，或从王事，无成有终。",
      "括囊，无咎无誉。",
      "黄裳，元吉。",
      "龙战于野，其血玄黄，用六则利永贞。"
    ]
  },
  "100000": {
    "index": 24,
    "name": "地雷复",
    "upper": "坤",
    "lower": "震",
    "upper_symbol": "☷",
    "lower_symbol": "☳",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "不远复，无祗悔，元吉。",
      "休复，吉。",
      "频复，厉无咎。",
      "中行独复。",
      "敦复，无悔。",
      "迷复，凶，有灾眚。用行师终有大败，以其国君凶，至于十年不克征。"
    ]
  },
  "110000": {
    "index": 19,
    "name": "地泽临",
    "upper": "坤",
    "lower": "兑",
    "upper_symbol": "☷",
    "lower_symbol": "☱",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "咸临，贞吉。",
      "咸临，吉无不利。",
      "甘临，无攸利。既忧之，无咎。",
      "至临，无咎。",
      "知临，大君之宜，吉。",
      "敦临，吉无咎。"
    ]
  },
  "111000": {
    "index": 11,
    "name": "地天泰",
    "upper": "坤",
    "lower": "乾",
    "upper_symbol": "☷",
    "lower_symbol": "☰",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "拔茅茹，以其汇，征吉。",
      "包荒，用冯河，不遐遗，朋亡，得尚于中行。",
      "无平不陂，无往不复，艰贞无咎。勿恤其孚，于食有福。",
      "翩翩不富以其邻，不戒以孚。",
      "帝乙归妹，以祉元吉。",
      "城复于隍，勿用师，自邑告命，贞吝。"
    ]
  },
  "111100": {
    "index": 34,
    "name": "雷天大壮",
    "upper": "震",
    "lower": "乾",
    "upper_symbol": "☳",
    "lower_symbol": "☰",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "壮于趾，征凶，有孚。",
      "贞吉。",
      "小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。",
      "贞吉悔亡。藩决不羸，壮于大舆之輹。",
      "丧羊于易，无悔。",
      "羝羊触藩，不能退不能遂，无攸利，艰则吉。"
    ]
  },
  "111110": {
    "index": 43,
    "name": "泽天夬",
    "upper": "兑",
    "lower": "乾",
    "upper_symbol": "☱",
    "lower_symbol": "☰",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 5,
    "yao_ci": [
      "壮于前趾，往不胜为咎。",
      "惕号，莫夜有戎，勿恤。",
      "壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠无咎。",
      "臀无肤，其行次且。牵羊悔亡，闻言不信。",
      "苋陆夬夬，中行无咎。",
      "无号，终有凶。"
    ]
  },
  "111010": {
    "index": 5,
    "name": "水天需",
    "upper": "坎",
    "lower": "乾",
    "upper_symbol": "☵",
    "lower_symbol": "☰",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 4,
    "yao_ci": [
      "需于郊，利用恒，无咎。",
      "需于沙，小有言，终吉。",
      "需于泥，致寇至。",
      "需于血，出自穴。",
      "需于酒食，贞吉。",
      "入于穴，有不速之客三人来，敬之终吉。"
    ]
  },
  "010000": {
    "index": 7,
    "name": "地水师",
    "upper": "坤",
    "lower": "坎",
    "upper_symbol": "☷",
    "lower_symbol": "☵",
    "palace": "坤",
    "element": "土",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "师出以律，否臧凶。",
      "在师中，吉无咎，王三锡命。",
      "师或舆尸，凶。",
      "师左次，无咎。",
      "田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。",
      "大君有命，开国承家，小人勿用。"
    ]
  },
  "110110": {
    "index": 58,
    "name": "兑为泽",
    "upper": "兑",
    "lower": "兑",
    "upper_symbol": "☱",
    "lower_symbol": "☱",
    "palace": "兑",
    "element": "金",
    "statement": "",
    "shi_position": 6,
    "yao_ci": [
      "和兑，吉。",
      "孚兑，吉，悔亡。",
      "来兑，凶。",
      "商兑未宁，介疾有喜。",
      "孚于剥，有厉。",
      "引兑。"
    ]
  },
  "010110": {
    "index": 47,
    "name": "泽水困",
    "upper": "兑",
    "lower": "坎",
    "upper_symbol": "☱",
    "lower_symbol": "☵",
    "palace": "兑",
    "element": "金",
    "statement": "",
    "shi_position": 1,
    "yao_ci": [
      "臀困于株木，入于幽谷，三岁不觌。",
      "困于酒食，朱绂方来，利用亨祀。征凶无咎。",
      "困于石，据于蒺藜，入于其宫不见其妻，凶。",
      "来徐徐，困于金车，吝有终。",
      "劓刖，困于赤绂，乃徐有说，利用祭祀。",
      "困于葛藟，于臲卼，曰动悔有悔，征吉。"
    ]
  },
  "000110": {
    "index": 45,
    "name": "泽地萃",
    "upper": "兑",
    "lower": "坤",
    "upper_symbol": "☱",
    "lower_symbol": "☷",
    "palace": "兑",
    "element": "金",
    "statement": "",
    "shi_position": 2,
    "yao_ci": [
      "有孚不终，乃乱乃萃，若号，一握为笑，勿恤，往无咎。",
      "引吉无咎，孚乃利用禴。",
      "萃如嗟如，无攸利。往无咎，小吝。",
      "大吉，无咎。",
      "萃有位，无咎，匪孚，元永贞，悔亡。",
      "赍咨涕洟，无咎。"
    ]
  },
  "001110": {
    "index": 31,
    "name": "泽山咸",
    "upper": "兑",
    "lower": "艮",
    "upper_symbol": "☱",
    "lower_symbol": "☶",
    "palace": "兑",
    "element": "金",
    "statement": "",
    "shi_position": 3,
    "yao_ci": [
      "咸其拇。",
      "咸其腓，凶，居吉。",
      "咸其股，执其随，往吝。",
      "贞吉悔亡，憧憧往来，朋从尔思。",
      "咸其脢，无悔。",
      "咸其辅颊舌。"
    ]
  },
  "001010": {
    "index": 39,
    "name": "水山蹇",
    "upper": "坎",
    "lower": "艮",
    "upper_symbol": "☵",
    "lower_symbol": "☶",
    "palace": "兑",
